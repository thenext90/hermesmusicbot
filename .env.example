# ── HermesMusicBot · copiar a .env y ajustar ────────────────────────────────
# cp .env.example .env

# ── HTTP API ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
# Si lo defines, todas las llamadas deben traer la cabecera X-API-Token: <valor>
API_TOKEN=

# ── Telegram (opcional) ─────────────────────────────────────────────────────
# Crear el bot con @BotFather y pegar el token acá:
TELEGRAM_TOKEN=
# Lista blanca de IDs de usuario separados por coma (vacío = cualquiera)
TELEGRAM_ALLOWED_USERS=

# ── Audio ───────────────────────────────────────────────────────────────────
# Vacío = dispositivo por defecto del sistema.
# Linux con PulseAudio/PipeWire: dejar vacío o "pulse".
# Ejemplo de dispositivo específico:
#   AUDIO_DEVICE=pulse/alsa_output.pci-0000_00_1f.3.analog-stereo
# Raspberry Pi con DAC USB:    AUDIO_DEVICE=alsa/default   (o "alsa/hw:1,0")
AUDIO_DEVICE=
DEFAULT_VOLUME=70
MPV_SOCKET=/tmp/musicbot-mpv.sock

# ── Binarios (cambiar solo si no están en el PATH) ──────────────────────────
MPV_BIN=mpv
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
# Argumentos extra para mpv, separados por espacios, ej: --audio-normalize=no
MPV_EXTRA_ARGS=

# ── yt-dlp ──────────────────────────────────────────────────────────────────
# Cookies del navegador en formato Netscape (útil si YouTube pide verificación)
YTDLP_COOKIES=
# Proxy, ej: http://127.0.0.1:8080
YTDLP_PROXY=
# Argumentos extra de yt-dlp, ej: --extractor-args "youtube:player_client=web"
YTDLP_EXTRA_ARGS=
# ytsearch1 = primer resultado; ytsearch3 = mira los 3 primeros
SEARCH_PREFIX=ytsearch1
# Filtro de extracción por si se prefiere siempre un contenedor concreto
YTDLP_FORMAT=bestaudio/best

# ── Cola y logs ─────────────────────────────────────────────────────────────
MAX_QUEUE=50
MAX_PLAYLIST=50
LOG_LEVEL=INFO
LOG_FILE=logs/musicbot.log
LOG_MAX_BYTES=2000000
LOG_BACKUPS=3

# ── Docker (solo lo usan los docker-compose*.yml) ───────────────────────────
# Puerto publicado en el host (por defecto 8080)
HOST_PORT=8080
# Carpeta de música local montada dentro del bot como /music (solo lectura)
MUSIC_PATH=./music
# Socket de PulseAudio/PipeWire del host (compose de PC). Otro usuario: /run/user/<uid>/pulse
PULSE_PATH=/run/user/1000/pulse
# Salida de audio dentro del contenedor: host | pulse-null (VPS) | null
# Los compose ya lo fijan solos; esto es por si se corre la imagen a mano.
AUDIO_MODE=host
# Nombre del sink nulo (modo VPS)
SINK_NAME=musicbot
# Retransmisión opcional del sink nulo a Icecast (modo VPS, perfil `stream`)
# Ejemplo: icecast://source:CLAVE@icecast:8000/music.mp3
STREAM_URL=
STREAM_BITRATE=128
# Claves del contenedor Icecast del perfil `stream` (cambiar antes de exponerlo)
ICECAST_SOURCE_PASSWORD=CAMBIAME
ICECAST_ADMIN_PASSWORD=CAMBIAME
ICECAST_RELAY_PASSWORD=CAMBIAME
ICECAST_HOSTNAME=localhost
ICECAST_PORT=8000
